# Скопируйте в .env.local и заполните своими ключами.
# .env.local уже в .gitignore — секреты не попадут в репозиторий.

# --- AI Director: OpenRouter (основной провайдер, БЕСПЛАТНЫЕ модели `:free`) ---
# Ключ: https://openrouter.ai/keys  (sk-or-v1-...)
OPENROUTER_API_KEY=
# Тот же ключ для клиентских вызовов («Магия», LLM-рейтинги фраз в браузере).
# Внимание: NEXT_PUBLIC_* встраивается в клиентский бандл.
NEXT_PUBLIC_OPENROUTER_API_KEY=

# --- Страховочный провайдер (необязательно) ---
# Ключ: https://console.groq.com  (gsk_...)
GROQ_API_KEY=

# --- Прочее (по желанию) ---
# POLLINATIONS_API_KEY=
